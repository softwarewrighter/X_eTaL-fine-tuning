#!/usr/bin/env xetal
## LoRA beside LoRA-FA, in two experiments kept apart. Experiment A,
## approximating a known matrix: both fit a known rank-4 shift T from
## the same seeded A, B at 0; LoRA moves A and B, LoRA-FA moves B
## alone. The best any update of the rank can do (the Eckart-Young
## optimum, from T's singular values), and the floor LoRA-FA cannot
## pass: its update s B A has its rows in the row space of the frozen
## A, a subspace, so the closest it can come to T is T's projection
## onto that subspace. Each learned update is projected onto the row
## space and the remainder measured. Experiment B, learning from
## examples: the task of lesson 3 (examples made by the hidden shift,
## some held out), LoRA, LoRA-FA and full fine-tuning of W itself, with
## the loss on the examples trained on, on the held-out ones, and on
## old examples, what the layer gave before any training, measured
## after it (retention).

"lo:" u_se< "LoRA"
"mx:" u_se< "Matrix"
"op:" u_se< "Optim"
"p:" u_se< "Plot"

### Data

## The settings: the rank, alpha (the strength s is alpha / r), the
## learning rate, how many of the 12 examples are trained on (the last
## 4 are always held out), and the record: chunks of every steps.
k := 4
alpha := 4.0
lr := 0.05
n := 8
chunks := 30
every := 10
## The frozen layer W, by a fixed ripple (the lab's), and the hidden
## shift T (8 x 8, of rank 4): what the adapter is to come to in
## Experiment A, and what the examples of Experiment B come from.
i := f_loat r_ange 64
W := 8 8 r_eshape s_in 0.7 * i * i
p := f_loat r_ange 32
T := (8 4 r_eshape 0.5 * s_in 1.3 * p * p) '+ '* i_nner 4 8 r_eshape 0.5 * c_os 0.6 * p * p
## The adapter as both methods start it, the same for both: B all 0,
## A seeded (fixed, no chance). LoRA trains A and B; LoRA-FA keeps A
## frozen and trains B.
s := alpha lo:s_caling k
A := 1 lo:s_eeded k c_at 8
B := (8 c_at k) r_eshape 0.0
a0 := (W, A, B, s)
r_avel T

### The spectrum of T

## T's singular values and, from them, the lowest loss any update of rank 1
## .. 8 can reach (Eckart-Young: half the sum of the squared singular
## values past the rank). The squared singular values are the
## eigenvalues of T' T, found by power iteration, each taken out once
## found; as X_eTaL-ML's lora-explorer writes it (ask FL2's
## workaround, until Matrix has a spectrum). The same lines run on a
## matrix built from known singular values, as a check.
u0 := 1.0 + 0.1 * f_loat r_ange 8
v := f_loat r_ange 8
H1 := (f_loat mx:i_dentity 8) - (2.0 * v '* t_able v) / '+ r_/ v * v
w := s_in f_loat r_ange 8
H2 := (f_loat mx:i_dentity 8) - (2.0 * w '* t_able w) / '+ r_/ w * w
known := 5.0 3.0 2.0 1.0 0.5 0.0 0.0 0.0
M := H1 '+ '* i_nner ((f_loat mx:i_dentity 8) * known '* t_able 8 r_eshape 1.0) '+ '* i_nner H2
spectra := '{ Gb -> G := d_isclose Gb
  (_, ev) := 8 '{ (Q, e) ->
    x := 300 '{ y -> m := Q '+ '* i_nner y
      m / 0.000000000000000001 + s_qrt '+ r_/ m * m } p_ower u0
    lam := '+ r_/ x * Q '+ '* i_nner x
    (Q - lam * x '* t_able x, e c_at lam)
  } p_ower (G, 0 r_eshape 0.0)
  0.0 m_ax ev } m_ap (e_nclose (o_\ T) '+ '* i_nner T) c_at e_nclose (o_\ M) '+ '* i_nner M
ev := d_isclose 1 s_elect spectra
## T's singular values; the lowest loss at each rank; the check (the
## largest difference between the known singular values and the ones
## found, small).
s_qrt ev
best := 0.5 * '{ j -> '+ r_/ j d_rop ev } e_ach r_ange 8
best
'm_ax r_/ a_bs known - s_qrt d_isclose 2 s_elect spectra

### Experiment A: approximating a known matrix

## Both fit T itself: the inputs are the identity's columns, the
## outputs wanted (W + T)'s, so the loss (lo:l_oss) is half the squared
## size of s B A - T. Adam (lo:a_dam, lo:a_damFA), chunks times every
## steps, the loss recorded after each chunk, the start first.
I := f_loat mx:i_dentity 8
(z1, fitL) := chunks '{ (z, L) ->
  z2 := every '{ e -> lr lo:a_dam (e, (I, W + T)) } p_ower z
  (a, _, _) := z2
  (z2, L c_at a lo:l_oss (I, W + T))
} p_ower (lo:a_damStart a0, a0 lo:l_oss (I, W + T))
(z2, fitF) := chunks '{ (z, L) ->
  z2 := every '{ e -> lr lo:a_damFA (e, (I, W + T)) } p_ower z
  (a, _, _) := z2
  (z2, L c_at a lo:l_oss (I, W + T))
} p_ower (lo:a_damStartFA a0, a0 lo:l_oss (I, W + T))
fitL
fitF
## What each learned: the update s B A of each.
((_, A1, B1, _), _, _) := z1
((_, A2, B2, _), _, _) := z2
D1 := lo:d_elta (A1, B1, s)
D2 := lo:d_elta (A2, B2, s)
r_avel D1
r_avel D2
## The row space of the frozen A: the projection onto it is P = A' (A
## A')^-1 A, through Matrix's inverse (ask FL3's workaround). A
## matrix's rows projected onto the subspace are M P; what is left, M
## - M P, is its remainder. The sizes (square root of the sum of
## squares) of the remainders of LoRA's update, LoRA-FA's and T
## itself: LoRA-FA's is 0 to rounding, its rows never left the
## subspace; LoRA's is not; T's is what LoRA-FA cannot reach.
P := (o_\ A) '+ '* i_nner (mx:i_nverse A '+ '* i_nner o_\ A) '+ '* i_nner A
rem := '{ Mb -> M2 := d_isclose Mb
  s_qrt '+ r_/ r_avel (M2 - M2 '+ '* i_nner P) ^ 2 } e_ach (e_nclose D1) c_at (e_nclose D2) c_at e_nclose T
rem
## LoRA-FA's floor (analytical): half the squared size of T's
## remainder, the loss of the best update whose rows stay in the
## subspace; beside LoRA's, the lowest for rank k from the spectrum.
(0.5 * (3 s_elect rem) ^ 2) c_at k s_elect best
## The counts (analytical): the numbers each trains (A and B, or B
## alone) and the numbers Adam holds for them while training (two per
## number trained).
(k lo:p_arams 8 8) c_at ('* r_/ s_hape B) c_at (2 * k lo:p_arams 8 8) c_at 2 * '* r_/ s_hape B
_ := ("Fitting T" "record" "loss" "LoRA" "LoRA-FA" "rank k limit" "FA floor") p:c_hart! (e_nclose fitL) c_at (e_nclose fitF) c_at (e_nclose (chunks + 1) r_eshape k s_elect best) c_at e_nclose (chunks + 1) r_eshape 0.5 * (3 s_elect rem) ^ 2

### Experiment B: learning from examples

## The task of lesson 3: 12 inputs by a ripple, the output wanted for
## each the shifted layer's; the first n trained on, the last 4 held
## out. And 4 old inputs, by another ripple, with the outputs the layer
## gave them before any training: what is to be kept.
c := f_loat r_ange 96
X := 8 12 r_eshape c_os 0.4 * c + 0.05 * c * c
Y := (W + T) '+ '* i_nner X
Xt := n t_ake_2 X
Yt := n t_ake_2 Y
Xh := -4 t_ake_2 X
Yh := -4 t_ake_2 Y
o := f_loat r_ange 32
Xo := 8 4 r_eshape s_in 0.9 * o + 0.03 * o * o
Yo := W '+ '* i_nner Xo
## The three losses per example of an adapted layer, trained on, held
## out and old, as one row.
losses := '{ a -> ((a lo:l_oss (Xt, Yt)) / f_loat n) c_at ((a lo:l_oss (Xh, Yh)) / 4.0) c_at (a lo:l_oss (Xo, Yo)) / 4.0 }
## LoRA and LoRA-FA from the same start, by Adam, with a record of the
## three losses after each chunk, the start first.
(y1, recL) := chunks '{ (z, L) ->
  z2 := every '{ e -> lr lo:a_dam (e, (Xt, Yt)) } p_ower z
  (a, _, _) := z2
  (z2, L c_at (losses)_ a)
} p_ower (lo:a_damStart a0, (losses)_ a0)
(y2, recF) := chunks '{ (z, L) ->
  z2 := every '{ e -> lr lo:a_damFA (e, (Xt, Yt)) } p_ower z
  (a, _, _) := z2
  (z2, L c_at (losses)_ a)
} p_ower (lo:a_damStartFA a0, (losses)_ a0)
## Full fine-tuning: W itself moves, every one of its 64 numbers, by
## Adam (op:a_dam) on the gradient of the same loss, the error times
## the inputs (written out, ask FM7's workaround). Its losses are
## measured through the same adapter form, with the empty adapter.
(y3, recW) := chunks '{ (z, L) ->
  z2 := every '{ (V, m, q, t) ->
    (V2, m2, q2) := (lr, t) op:a_dam (V, m, q, ((V '+ '* i_nner Xt) - Yt) '+ '* i_nner o_\ Xt)
    (V2, m2, q2, t + 1) } p_ower z
  (V3, _, _, _) := z2
  (z2, L c_at (losses)_ (V3, A, B, s))
} p_ower ((W, 0.0 * W, 0.0 * W, 1), (losses)_ a0)
recL
recF
recW
## How far each moved the layer's old outputs: the size of the change
## of the whole layer, s B A or the moved W less W (measured).
((_, A3, B3, _), _, _) := y1
((_, A4, B4, _), _, _) := y2
(W5, _, _, _) := y3
(s_qrt '+ r_/ r_avel (lo:d_elta (A3, B3, s)) ^ 2) c_at (s_qrt '+ r_/ r_avel (lo:d_elta (A4, B4, s)) ^ 2) c_at s_qrt '+ r_/ r_avel (W5 - W) ^ 2
## The records side by side, a row per record: LoRA's three losses,
## then LoRA-FA's, then full fine-tuning's; and the three losses as one
## chart each, a record a point.
R := ((chunks + 1 c_at 3) r_eshape recL) c_at_2 ((chunks + 1 c_at 3) r_eshape recF) c_at_2 (chunks + 1 c_at 3) r_eshape recW
_ := ("Trained on" "record" "loss per example" "LoRA" "LoRA-FA" "full") p:c_hart! '{ j -> j s_elect_2 R } m_ap 1 4 7
_ := ("Held out" "record" "loss per example" "LoRA" "LoRA-FA" "full") p:c_hart! '{ j -> j s_elect_2 R } m_ap 2 5 8
_ := ("Old examples" "record" "loss per example" "LoRA" "LoRA-FA" "full") p:c_hart! '{ j -> j s_elect_2 R } m_ap 3 6 9
